# devops-env-config :: SSO settings.  PLACEHOLDERS ONLY — fill in your own values.
#
#   install -m 600 config/sso/sso.env.example ~/.config/devops-env/sso.env
#   ${EDITOR:-vi} ~/.config/devops-env/sso.env
#
# `devenv --only auth-sso` seeds it for you and NEVER overwrites it afterwards.
# NEVER commit the filled file: this is the only place a real hostname is written.
# Sourced by ~/.bashrc.d/55-sso.sh, `sso-login` and `sso-kubeconfig-add`.

OIDC_ISSUER_URL="https://sso.example.com/realms/REALM_PLACEHOLDER"
OIDC_CLIENT_ID="kubernetes" # public client, PKCE S256, no secret
OIDC_GROUPS_SCOPE="groups"  # realm-specific: match your group-membership mapper
OIDC_USER_NAME="oidc"       # one kubeconfig user, reused by every context
OIDC_LISTEN_PORT="8000"     # pinned so the redirect URL is deterministic

# Space-separated. Leave unset to act on the current context only.
#SSO_KUBE_CONTEXTS=""
#SSO_AKS_CONTEXTS=""

#ARGOCD_SERVER="argocd.example.com"
#SSO_ARGOCD_MODE="core"     # core | sso
#BAO_ADDR="https://openbao.example.com:8200"
#BAO_ROLE="ROLE_PLACEHOLDER"
#GITLAB_HOST="gitlab.example.com"

# Browser shim overrides (see docs/sso.md)
#DEVENV_BROWSER_MODE="auto" # auto | wsl | gui | print | command
#DEVENV_BROWSER_CMD=""
#DEVENV_BROWSER_WIN_EXE=""
#DEVENV_BROWSER_QR="0"
#DEVENV_CLIP_BACKEND="auto" # auto | wslclip | wayland | x11 | osc52
