#!/usr/bin/env bash
# clip — copy stdin to the clipboard.  linux-devops-tools
# ~/.local/bin/pbcopy is a symlink to this file.
#
# An EXECUTABLE, not a shell function, because tmux copy-pipe, k9s plugins, a
# kubeconfig `exec`, cron and systemd units all need a real command.
# `set -e` is deliberately OFF here: these shims probe several backends and a
# failing probe must degrade to the next one, never abort the user's login flow.
set -uo pipefail
# shellcheck source=/dev/null
. "${DEVENV_LIB_DIR:-$HOME/.local/lib/devops-env}/detect.sh" 2>/dev/null || exit 0

data=$(cat) # trailing newlines dropped, on purpose

case "$(dv_clip_backend)" in
  wslclip)
    # Absolute path: the Windows PATH is not necessarily on this shell's PATH,
    # so `clip.exe` may not resolve by name even with interop enabled.
    win=$(dv_win_root) || exit 0
    clipexe="$win/Windows/System32/clip.exe"
    [ -x "$clipexe" ] || exit 0
    if command -v iconv >/dev/null 2>&1; then
      printf '%s' "$data" | iconv -f UTF-8 -t UTF-16LE | "$clipexe"
    else
      printf '%s' "$data" | "$clipexe" # ASCII-safe fallback
    fi
    ;;
  wayland) printf '%s' "$data" | wl-copy ;;
  x11) printf '%s' "$data" | xclip -selection clipboard ;;
  osc52)
    # Lands in the LAPTOP's clipboard via the terminal emulator. tmux forwards
    # it when `allow-passthrough on` + `set-clipboard on` are set (both already
    # are in Ujstor/tmux-config) AND the outer terminal declares an Ms entry —
    # see config/tmux/devenv-clipboard.conf.
    # Keep payloads to URLs and tokens: tmux drops multi-hundred-KB sequences.
    printf '\033]52;c;%s\a' "$(printf '%s' "$data" | base64 | tr -d '\n')" | dv_tty
    [ -n "${TMUX:-}" ] && printf '%s' "$data" | tmux load-buffer - 2>/dev/null
    :
    ;;
esac
exit 0
