#!/usr/bin/env bash
# sso-kubeconfig-add — add (or refresh) the Keycloak OIDC user in your kubeconfig.
# devops-env-config
#
#   sso-kubeconfig-add [--user NAME] [--context CTX]… [--headless]
#                      [--dry-run] [--yes] [--all-contexts]
#
# Values come from ~/.config/devops-env/sso.env — the only file on this box that
# holds a real issuer URL. Nothing here is ever committed.
#
# The write goes through `kubectl config set-credentials`, never a hand-rolled YAML
# merge: kubectl owns the file's formatting and leaves every unrelated stanza alone.
# The kubeconfig is copied to a timestamped backup first, and nothing is applied
# without a confirmation.
#
# The grant type lives IN THE KUBECONFIG, chosen once per host:
#   default     authcode pinned to 127.0.0.1:${OIDC_LISTEN_PORT:-8000}
#               (tunnel it with `ssh -L 8000:localhost:8000` FROM your laptop)
#   --headless  authcode-keyboard + urn:ietf:wg:oauth:2.0:oob (paste the code back)
# The redirect URL is part of kubelogin's token-cache key while the grant type is
# not — putting the mode in the kubeconfig is what stops a second, silent login.
# `set -e` is deliberately OFF here: these shims probe several backends and a
# failing probe must degrade to the next one, never abort the user's login flow.
set -uo pipefail

PROG=${0##*/}
CONF_DIR="${DEVENV_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/devops-env}"
CONF="$CONF_DIR/sso.env"

say() { printf '%s\n' "$*" >&2; }
err() { printf '%s: %s\n' "$PROG" "$*" >&2; }

usage() {
  cat >&2 <<EOF
usage: $PROG [--user NAME] [--context CTX]… [--all-contexts]
             [--headless] [--dry-run] [--yes]

  --user NAME      kubeconfig user to create/replace (default: \$OIDC_USER_NAME or "oidc")
  --context CTX    also point CTX at that user; repeatable
  --all-contexts   point EVERY context in the kubeconfig at that user
  --headless       no browser and no tunnel possible: OOB paste-back flow
  --dry-run        print what would happen, touch nothing
  --yes            do not ask
EOF
}

user=''
i=''
backup=''
patched=''
contexts=()
headless=0
dry=0
assume_yes=0
all_contexts=0

need_value() {
  if [ "$2" -lt 2 ]; then
    err "$1 needs a value"
    exit 2
  fi
}

while [ $# -gt 0 ]; do
  case "$1" in
    --user)
      need_value "$1" $#
      user=$2
      shift 2
      ;;
    --user=*)
      user=${1#*=}
      shift
      ;;
    --context)
      need_value "$1" $#
      contexts+=("$2")
      shift 2
      ;;
    --context=*)
      contexts+=("${1#*=}")
      shift
      ;;
    --all-contexts)
      all_contexts=1
      shift
      ;;
    --headless)
      headless=1
      shift
      ;;
    --dry-run)
      dry=1
      shift
      ;;
    --yes | -y)
      assume_yes=1
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      err "unknown argument '$1'"
      usage
      exit 2
      ;;
  esac
done

command -v kubectl >/dev/null 2>&1 || {
  err 'kubectl is not installed'
  exit 1
}

if [ -r "$CONF" ]; then
  # shellcheck source=/dev/null
  . "$CONF"
else
  err "missing $CONF"
  err '  seed it from config/sso/sso.env.example and fill in your issuer.'
  exit 1
fi

for v in OIDC_ISSUER_URL OIDC_CLIENT_ID; do
  if [ -z "${!v:-}" ]; then
    err "$v is not set in $CONF"
    exit 1
  fi
done

user=${user:-${OIDC_USER_NAME:-oidc}}
groups_scope=${OIDC_GROUPS_SCOPE:-groups}
listen_port=${OIDC_LISTEN_PORT:-8000}

# Which file will kubectl actually write? The FIRST entry of $KUBECONFIG, else
# ~/.kube/config. A multi-file KUBECONFIG is reported, never silently merged.
target=${KUBECONFIG:-$HOME/.kube/config}
case "$target" in
  *:*)
    say "KUBECONFIG lists several files; kubectl writes to the first one only:"
    target=${target%%:*}
    say "  $target"
    ;;
esac

# NOTE: there is deliberately no --exec-interactive-mode here. That flag does not
# exist: `kubectl config set-credentials` accepts only --exec-{api-version,command,
# arg,env}. interactiveMode is written in a separate, verified step further down.
args=(
  "--exec-api-version=client.authentication.k8s.io/v1"
  "--exec-command=kubectl"
  "--exec-arg=oidc-login"
  "--exec-arg=get-token"
  "--exec-arg=--oidc-issuer-url=$OIDC_ISSUER_URL"
  "--exec-arg=--oidc-client-id=$OIDC_CLIENT_ID"
  "--exec-arg=--oidc-extra-scope=profile"
  "--exec-arg=--oidc-extra-scope=email"
  "--exec-arg=--oidc-extra-scope=$groups_scope"
)
if [ "$headless" = 1 ]; then
  args+=(
    "--exec-arg=--grant-type=authcode-keyboard"
    "--exec-arg=--oidc-redirect-url=urn:ietf:wg:oauth:2.0:oob"
  )
else
  args+=(
    "--exec-arg=--listen-address=127.0.0.1:$listen_port"
  )
fi
args+=("--exec-arg=--authentication-timeout-sec=600")

if [ "$all_contexts" = 1 ]; then
  while IFS= read -r c; do
    [ -n "$c" ] && contexts+=("$c")
  done < <(kubectl config get-contexts -o name 2>/dev/null)
fi

if [ "$headless" = 1 ]; then
  flow='authcode-keyboard (OOB paste-back, no listener, no tunnel)'
else
  flow="authcode on 127.0.0.1:$listen_port (ssh -L $listen_port:localhost:$listen_port from your laptop)"
fi

say "kubeconfig : $target"
say "user       : $user"
say "flow       : $flow"
if [ ${#contexts[@]} -gt 0 ]; then
  say "contexts   : ${contexts[*]}"
else
  say 'contexts   : none (add --context CTX or --all-contexts to rewire them)'
fi

existing=$(kubectl config view -o "jsonpath={.users[?(@.name=='$user')]}" 2>/dev/null || true)
if [ -n "$existing" ]; then
  say ''
  say "user '$user' already exists and will be REPLACED. It is currently:"
  printf '%s\n' "$existing" | sed 's/^/  /' >&2
fi

say ''
say 'would run:'
{
  printf '  kubectl config set-credentials %s \\\n' "$user"
  for i in "${!args[@]}"; do
    if [ "$i" -lt $((${#args[@]} - 1)) ]; then
      printf '    %s \\\n' "${args[$i]}"
    else
      printf '    %s\n\n' "${args[$i]}"
    fi
  done
  printf '  # then, because set-credentials cannot write it:\n'
  printf '  users.%s.exec.interactiveMode: IfAvailable\n\n' "$user"
  for c in ${contexts[@]+"${contexts[@]}"}; do
    printf '  kubectl config set-context %s --user=%s\n' "$c" "$user"
  done
} >&2

if [ "$dry" = 1 ]; then
  say ''
  say 'dry run: nothing was changed.'
  exit 0
fi

if [ "$assume_yes" != 1 ]; then
  if [ ! -c /dev/tty ] || ! { : >/dev/tty; } 2>/dev/null; then
    err 'no terminal to confirm on; re-run with --yes if you mean it'
    exit 1
  fi
  printf 'apply this to %s? [y/N] ' "$target" >&2
  read -r ans </dev/tty || ans=''
  case "$ans" in
    [yY] | [yY][eE][sS]) ;;
    *)
      say 'nothing was changed.'
      exit 0
      ;;
  esac
fi

if [ -f "$target" ]; then
  backup="$target.devenv.$(date -u +%Y%m%dT%H%M%SZ).bak"
  cp -p -- "$target" "$backup" || {
    err "could not back up $target"
    exit 1
  }
  chmod 600 -- "$backup" 2>/dev/null || true
  say "backed up $target -> $backup"
fi

kubectl config set-credentials "$user" "${args[@]}" || {
  err 'kubectl config set-credentials failed'
  exit 1
}

# interactiveMode is REQUIRED at client.authentication.k8s.io/v1: without it every
# kubectl call through this user dies with "interactiveMode must be specified".
#
# And `kubectl config set-credentials` cannot write it — the flag set is exactly
# --exec-{api-version,command,arg,env} and nothing else (checked against v1.29;
# `kubectl config set users.X.exec.interactiveMode IfAvailable` fails too, with
# "unable to parse one or more field values", because it is a typed string).
#
# So: ask kubectl first, in case a newer one grew the ability, and only then insert
# the single line ourselves — into the block kubectl has just written, whose shape
# is therefore known — and immediately verify by reading it back through kubectl.
read_mode() {
  kubectl config view -o "jsonpath={.users[?(@.name=='$user')].user.exec.interactiveMode}" 2>/dev/null
}

if [ -z "$(read_mode)" ]; then
  kubectl config set "users.$user.exec.interactiveMode" IfAvailable >/dev/null 2>&1 || true
fi

if [ -z "$(read_mode)" ]; then
  patched="$target.devenv-interactivemode.$$"
  if awk -v user="$user" '
      /^users:/            { inusers = 1; print; next }
      inusers && /^[^ -]/  { inusers = 0 }
      inusers && /^- name: / { cur = substr($0, 9) }
      inusers && cur == user && /^      command: / && !done {
        print
        print "      interactiveMode: IfAvailable"
        done = 1
        next
      }
      { print }
    ' "$target" >"$patched" 2>/dev/null \
    && [ -s "$patched" ] \
    && [ "$(KUBECONFIG=$patched kubectl config view -o "jsonpath={.users[?(@.name=='$user')].user.exec.interactiveMode}" 2>/dev/null)" = IfAvailable ]; then
    cat -- "$patched" >"$target"
    rm -f -- "$patched"
  else
    rm -f -- "$patched"
    err 'could not set exec.interactiveMode, which v1 requires.'
    err "restoring $target from ${backup:-the backup} and changing nothing."
    [ -n "${backup:-}" ] && [ -f "$backup" ] && cat -- "$backup" >"$target"
    exit 1
  fi
fi

for c in ${contexts[@]+"${contexts[@]}"}; do
  kubectl config set-context "$c" --user="$user" || err "could not rewire context $c"
done

say ''
say 'done. Verify with:'
if [ ${#contexts[@]} -gt 0 ]; then
  say "  kubectl auth whoami --context ${contexts[0]}"
else
  say '  kubectl auth whoami'
fi
# shellcheck disable=SC2016  # backticks are prose here, not a substitution
say 'A missing `groups` claim is the #1 failure here — auth whoami prints it.'
