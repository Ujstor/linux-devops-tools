# linux-devops-tools :: private tooling settings.  PLACEHOLDERS ONLY.
#
# `devenv --profile private` seeds this file at ~/.config/devops-env/private.env
# (mode 0600) and never overwrites it. That copy is where your real values live;
# it is gitignored, and nothing in this repository ever reads a hostname from
# anywhere else.
#
# Every value below is EMPTY on purpose. With DEVENV_PRIVATE_HOST unset the
# module does nothing at all and still succeeds, which is what makes a public
# checkout, a fresh VM and a CI runner behave identically.
#
# The examples in the comments use RFC 2606 reserved names. Do not commit real
# ones back into this file — this repository is public.

# ---------------------------------------------------------------------------
# The host
# ---------------------------------------------------------------------------
# host or host:port of your private git forge. A scheme and a path are stripped
# if you paste a URL. Empty => the module no-ops.
#   DEVENV_PRIVATE_HOST="gitlab.example.com"
DEVENV_PRIVATE_HOST=

# TCP port for the reachability probe. Default 443. An embedded :port in
# DEVENV_PRIVATE_HOST wins over this.
#   DEVENV_PRIVATE_PORT="443"
DEVENV_PRIVATE_PORT=

# Seconds to wait for that probe before giving up and skipping the module.
# Default 3 — long enough on a VPN, short enough not to stall an install in a
# café.
#   DEVENV_PRIVATE_PROBE_TIMEOUT="3"
DEVENV_PRIVATE_PROBE_TIMEOUT=

# ---------------------------------------------------------------------------
# Tools built with `go install`
# ---------------------------------------------------------------------------
# Space-separated <module-path>@<version>. Every entry must start with
# DEVENV_PRIVATE_HOST; anything else is ignored with a warning, because
# GOPRIVATE is set to that host and a public path there would be a mistake.
#
#   DEVENV_PRIVATE_TOOLS="\
#     gitlab.example.com/group/tool-one@v1.4.0 \
#     gitlab.example.com/group/subgroup/tool-two@v0.9.2"
#
# The command name is the last element of the module path, and its bash
# completion is cached automatically if the tool has a `completion bash`
# subcommand — and silently skipped if it does not.
DEVENV_PRIVATE_TOOLS=

# ---------------------------------------------------------------------------
# Tools downloaded from a release (for anything not `go get`-able)
# ---------------------------------------------------------------------------
# Space-separated <project-path>@<tag>:<asset>:<command>, fetched with
# `glab release download`. A .deb is installed with apt; a .tar.gz is unpacked
# and <command> is taken out of it; anything else is installed as the binary
# itself, into ~/.local/bin.
#
#   DEVENV_PRIVATE_RELEASE_TOOLS="\
#     group/tool-three@v2.1.0:tool-three_linux_amd64.tar.gz:tool-three"
DEVENV_PRIVATE_RELEASE_TOOLS=

# ---------------------------------------------------------------------------
# Authentication — supplied by you, never by this repository
# ---------------------------------------------------------------------------
# The module writes no credential of any kind: no ~/.netrc entry, no git
# `insteadOf` rewrite, no token file, and it never prompts for one. `go install`
# and `glab` use whatever you already have:
#
#   * an ssh-agent key, with a git insteadOf rewrite you configured yourself, or
#   * ~/.netrc (mode 0600) with a machine entry for the host, or
#   * `glab auth login --hostname <host>`, or
#   * $GITLAB_TOKEN in the environment.
#
# If a build fails with a 401 or an ssh permission error, that is the layer to
# look at — not this file.
